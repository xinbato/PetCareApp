## This is a template file for local environment configurations.
## Copy this file to 'local.properties' and fill in your actual keys.
## 'local.properties' is gitignored and will NEVER be pushed to Git.

# Path to your Android SDK (Required)
# sdk.dir=C\:\\Users\\YourUsername\\AppData\\Local\\Android\\Sdk

# Google AI Studio API Key for Pet Scanner (Free tier from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Google Maps Platform API Key (Optional for maps)
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

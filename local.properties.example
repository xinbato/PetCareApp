## This file must *NOT* be checked into Version Control Systems.
## Copy this file to 'local.properties' and fill in your actual local settings.

# Path to your Android SDK (Required)
# sdk.dir=C\:\\Users\\YourUsername\\AppData\\Local\\Android\\Sdk

# Google Maps Platform API Key (Required only for Map tile rendering; List view works via OpenStreetMap)
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# AI Pet Scanner uses Firebase AI Logic + Firebase App Check (no static GEMINI_API_KEY in client APK).
# Enable Firebase AI Logic and App Check in Firebase Console for project petcareapp-fa54c.
